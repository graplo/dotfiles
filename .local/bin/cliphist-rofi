#!/usr/bin/env bash
# You have a small bug in your code
#           \ /
#           oVo
#       \___XXX___/
#        __XXXXX__
#       /__XXXXX__\
#       /   GPL   \
#            V
 
tmp_dir="/tmp/cliphist"

if [[ -n "$1" ]]; then
    cliphist decode <<<"$1" | wl-copy
    exit
fi

if [[ -n "$ROFI_RETV" ]]; then
    rm -rf "$tmp_dir"
    mkdir -p "$tmp_dir"
    read -r -d '' prog <<EOF
/^[0-9]+\s<meta http-equiv=/ { next }

match(\$0, /^([0-9]+)\s(\[\[\s)?binary.*(jpg|jpeg|png|bmp)/, grp) {
    system("echo " grp[1] "\\\\\t | cliphist decode >$tmp_dir/"grp[1]"."grp[3])
    print \$0"\0icon\x1f$tmp_dir/"grp[1]"."grp[3]
    next
}

{
    print \$0"\0icon\x1f/home/graplo/.config/rofi/Icons/edit-paste.svg"
}
EOF
    cliphist list | gawk "$prog"
    exit
fi

rofi \
    -modi "clipboard:/home/graplo/.local/bin/cliphist-rofi" \
    -show clipboard \
    -show-icons \
    -theme ~/.config/rofi/themes/clipwalker.rasi \
    -display-columns 2 \
    -p "󰅍 Portapapeles"
