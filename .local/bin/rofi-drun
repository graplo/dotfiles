#!/usr/bin/env bash
# ~/.local/bin/rofi-random-bg
# Elige una imagen al azar del pool y actualiza el symlink que consume el tema.

POOL_DIR="$HOME/.config/rofi/images/pool"
LINK="$HOME/.config/rofi/images/drun"

IMG=$(find "$POOL_DIR" -maxdepth 1 -type f \
    \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) \
    | shuf -n 1)

if [[ -n "$IMG" ]]; then
    ln -sf "$IMG" "$LINK"
fi

exec rofi -show drun
