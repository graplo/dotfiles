#!/usr/bin/env bash

# Archivo de caché por si falla internet
CACHE="$HOME/.cache/weather-eww.json"

# Función para convertir código de wttr a ícono Nerd Font
get_icon() {
    local code="$1"
    local night="$2"
    case $code in
        113) [[ $night == "true" ]] && echo "" || echo "" ;;
        116) [[ $night == "true" ]] && echo "" || echo "" ;;
        119|122) echo "" ;;
        143|248|260) echo "" ;;
        176|263|353) [[ $night == "true" ]] && echo "" || echo "" ;;
        179|227|230|323|326|368) [[ $night == "true" ]] && echo "" || echo "" ;;
        182|185|281|284|311|314|317|320|350|362|365|374|377) echo "" ;;
        200|386|389|392|395) echo "" ;;
        266|293|296|299|302|305|308|356|359) echo "" ;;
        329|332|335|338|371) echo "" ;;
        *) echo "" ;;
    esac
}

# Nombre del día de la semana
get_day_name() {
    date -d "$1" "+%a" 2>/dev/null | tr '[:lower:]' '[:upper:]'
}

RAW=$(curl -fsS --max-time 4 "https://wttr.in?format=j1" 2>/dev/null)

if [ -z "$RAW" ]; then
    [ -f "$CACHE" ] && cat "$CACHE" || echo "{}"
    exit 0
fi

# Parsear datos actuales
city=$(echo "$RAW" | jq -r '.nearest_area[0].areaName[0].value' | tr '[:lower:]' '[:upper:]')
temp=$(echo "$RAW" | jq -r '.current_condition[0].temp_C')
feels=$(echo "$RAW" | jq -r '.current_condition[0].FeelsLikeC')
wind=$(echo "$RAW" | jq -r '.current_condition[0].windspeedKmph')
humidity=$(echo "$RAW" | jq -r '.current_condition[0].humidity')
code=$(echo "$RAW" | jq -r '.current_condition[0].weatherCode')
sunrise=$(echo "$RAW" | jq -r '.weather[0].astronomy[0].sunrise')
sunset=$(echo "$RAW" | jq -r '.weather[0].astronomy[0].sunset')

# Comprobar si es de noche
now_epoch=$(date +%s)
sunrise_epoch=$(date -d "today $sunrise" +%s 2>/dev/null || echo 0)
sunset_epoch=$(date -d "today $sunset" +%s 2>/dev/null || echo 0)
if (( sunrise_epoch > 0 && sunset_epoch > 0 && (now_epoch < sunrise_epoch || now_epoch >= sunset_epoch) )); then
    night=true
else
    night=false
fi

icon=$(get_icon "$code" "$night")

# Pronóstico de los próximos 3 días
d0_name=$(get_day_name "$(echo "$RAW" | jq -r '.weather[0].date')")
d0_max=$(echo "$RAW" | jq -r '.weather[0].maxtempC')
d0_min=$(echo "$RAW" | jq -r '.weather[0].mintempC')
d0_code=$(echo "$RAW" | jq -r '.weather[0].hourly[4].weatherCode')
d0_icon=$(get_icon "$d0_code" "false")

d1_name=$(get_day_name "$(echo "$RAW" | jq -r '.weather[1].date')")
d1_max=$(echo "$RAW" | jq -r '.weather[1].maxtempC')
d1_min=$(echo "$RAW" | jq -r '.weather[1].mintempC')
d1_code=$(echo "$RAW" | jq -r '.weather[1].hourly[4].weatherCode')
d1_icon=$(get_icon "$d1_code" "false")

d2_name=$(get_day_name "$(echo "$RAW" | jq -r '.weather[2].date')")
d2_max=$(echo "$RAW" | jq -r '.weather[2].maxtempC')
d2_min=$(echo "$RAW" | jq -r '.weather[2].mintempC')
d2_code=$(echo "$RAW" | jq -r '.weather[2].hourly[4].weatherCode')
d2_icon=$(get_icon "$d2_code" "false")

JSON=$(jq -n \
  --arg city "$city" \
  --arg temp "$temp" \
  --arg feels "$feels" \
  --arg wind "$wind" \
  --arg humidity "$humidity" \
  --arg icon "$icon" \
  --arg d0_name "$d0_name" --arg d0_max "$d0_max" --arg d0_min "$d0_min" --arg d0_icon "$d0_icon" \
  --arg d1_name "$d1_name" --arg d1_max "$d1_max" --arg d1_min "$d1_min" --arg d1_icon "$d1_icon" \
  --arg d2_name "$d2_name" --arg d2_max "$d2_max" --arg d2_min "$d2_min" --arg d2_icon "$d2_icon" \
  '{
    city: $city,
    temp: $temp,
    feels: $feels,
    wind: $wind,
    humidity: $humidity,
    icon: $icon,
    forecast: [
      {day: $d0_name, max: $d0_max, min: $d0_min, icon: $d0_icon},
      {day: $d1_name, max: $d1_max, min: $d1_min, icon: $d1_icon},
      {day: $d2_name, max: $d2_max, min: $d2_min, icon: $d2_icon}
    ]
  }')

echo "$JSON" | tee "$CACHE"
