#!/usr/bin/env bash
# ~/.local/bin/rofi-files

fd --type f . "$HOME" \
    --exclude Roms --exclude retroarch \
    | rofi-launch file-browser-extended \
        -file-browser-stdin \
        -file-browser-no-descend \
        -file-browser-disable-status \
        -theme ~/.config/rofi/themes/file.rasi
