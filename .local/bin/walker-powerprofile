#!/usr/bin/env bash
# ~/.local/bin/walker-powerprofile
POOL="$HOME/.config/walker/pool"
CSS="$HOME/.config/walker/themes/dracula-power/style.css"
IMG=$(find -L "$POOL" -maxdepth 1 -type f \
    \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) \
    | shuf -n 1)
if [[ -n "$IMG" ]]; then
    sed -i "s|background-image: url(\".*\")|background-image: url(\"$IMG\")|" "$CSS"
fi
walker -s powerprofile -t dracula-power
