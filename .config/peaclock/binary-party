# peaclock - Dracula party config

block 8 4
padding 4 1
margin 1 1
ratio 2 1
date-padding 1
fill '󰘧GRAPLO󰘧'
locale ''
timezone 'America/Lima'
date '%a %d %b %H:%M:%S'
mode clock
view binary
toggle padding
stopwatch start
timer 10m:0s
timer-exec 'notify-send -a peaclock "timer complete"'
rate-input 50
rate-refresh 1000
rate-status 5000

set hour-24 on
set seconds on
set date on
set auto-size off
set auto-ratio on

style active-fg party
style inactive-fg #44475A
style colon-fg clear
style active-bg clear
style inactive-bg clear
style colon-bg #282A36
style date #8BE9FD
style background clear
style text #F8F8F2
style prompt #BD93F9
style success #50FA7B
style error #FF5555
