;; ==========================================
;; TIME & POMODORO PANEL (OVERLAY CONCEPT)
;; ==========================================

(defpoll dna-frame :interval "33ms" "$HOME/.local/bin/eww-dna")
(defpoll current_time :interval "1s" "date '+%H:%M'")
(defpoll current_date :interval "60s" "date '+%A, %d %B'")
(defpoll pomo_time :interval "1s" "$HOME/.local/bin/eww-pomodoro get")
(defpoll pomo_state :interval "1s" "$HOME/.local/bin/eww-pomodoro state")

(defwidget time-panel []
  (box :class "panel" :orientation "v" :spacing 10 :space-evenly false
    
    ;; Contenedor Overlay (ADN al fondo, Hora flotando al centro)
    (overlay
      ;; Fondo: Animación de ADN
      (box :class "dna-box" :orientation "v" :space-evenly false :halign "center" :valign "center"
        (label :text dna-frame :class "dna-text" :vexpand true)
        (label :text "─── [ DNA Sequence ] ───" :class "dna-label"))

      ;; Frente: Caja flotante con Reloj y Fecha (Estilo Fetch/Dracula)
      (box :class "time-overlay-box" 
           :orientation "v" 
           :space-evenly false 
           :spacing 4 
           :halign "center" 
           :valign "center"
        (box :orientation "h" :space-evenly false :spacing 8 :halign "center"
          (label :text "󰥔" :class "overlay-clock-icon")
          (label :text current_time :class "overlay-time-text"))
        (label :text current_date :class "overlay-date-text"))
    )

    ;; Tarjeta del Pomodoro (Mantiene su lugar abajo)
    (box :class "pomodoro-card" :orientation "v" :space-evenly false :spacing 8 :halign "fill"
      (box :orientation "h" :space-evenly true
        (label :text "[POMODORO]" :class "mem-header")
        (label :text "[${pomo_state}]" :class "cpu-usage"))
      
      (label :text pomo_time :class "pomo-timer-text" :halign "center")
      
      (box :orientation "h" :spacing 8 :space-evenly true
        (button :onclick "$HOME/.local/bin/eww-pomodoro toggle" "Iniciar / Pausa")
        (button :onclick "$HOME/.local/bin/eww-pomodoro reset" "Reset")))))

;; Ventana
(defwindow time-panel
  :monitor 0
  :stacking "overlay"
  :geometry (geometry :anchor "top right"
                      :x "10px"
                      :y "5px"
                      :width "300px")
  (time-panel))
