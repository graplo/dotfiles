;; ==========================================
;; AUDIO PANEL
;; ==========================================


;; ==================================================
;; LISTAS DINÁMICAS
;; ==================================================

(defpoll audio-devices
  :interval "5s"
  "scripts/audio-devices json")

(defpoll audio-input-devices
  :interval "5s"
  "scripts/audio-devices input-json")


;; ==================================================
;; OUTPUT - VOLUMEN
;; ==================================================

(defpoll audio-out-vol
  :interval "1s"
  "wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{printf \"%d\", $2 * 100}'")

(defpoll audio-out-muted
  :interval "1s"
  "wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q MUTED && echo true || echo false")


;; ==================================================
;; INPUT - VOLUMEN
;; ==================================================

(defpoll audio-in-vol
  :interval "1s"
  "wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | awk '{printf \"%d\", $2 * 100}'")

(defpoll audio-in-muted
  :interval "1s"
  "wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED && echo true || echo false")


;; ==================================================
;; FILA OUTPUT
;; ==================================================

(defwidget audio-device-row [name id current]
  (button
    :class "audio-device-row ${current ? 'active' : ''}"
    :onclick "scripts/audio-devices set ${id}"

    (box
      :orientation "h"
      :space-evenly false
      :spacing 10

      (label
        :text "${current ? '󰮯' : '󰊠'}"
        :class "audio-device-indicator")

      (label
        :text name
        :class "audio-device-name"
        :halign "start"
        :hexpand true)
    )
  )
)


;; ==================================================
;; FILA INPUT
;; ==================================================

(defwidget audio-input-row [name id current]
  (button

    :class "audio-device-row ${current ? 'active' : ''}"
    :onclick "scripts/audio-devices set ${id}"

    (box
      :orientation "h"
      :space-evenly false
      :spacing 10

      (label
        :text "${current ? '󰮯' : '󰊠'}"
        :class "audio-device-indicator")

      (label
        :text name
        :class "audio-device-name"
        :halign "start"
        :hexpand true)
    )
  )
)


;; ==================================================
;; WIDGET PRINCIPAL
;; ==================================================

(defwidget audio-widget []
  (box
    :orientation "v"
    :spacing 10
    :space-evenly false
    :class "panel"


    ;; ==============================================
    ;; HEADER
    ;; ==============================================

    (box
      :orientation "h"
      :space-evenly false
      :spacing 10

      (label
        :text "${audio-out-muted == 'true'
          ? '󰝟'
          : audio-out-vol < 33
          ? '󰕿'
          : audio-out-vol < 66
          ? '󰖀'
          : '󰕾'}"
        :class "main-audio-icon")

      (box
        :orientation "v"
        :space-evenly false

        (label
          :text "Audio"
          :class "title"
          :halign "start")

        (label
          :text "${audio-out-muted == 'true'
            ? 'MUTED'
            : audio-out-vol + '%'}"
          :class "subtitle"
          :halign "start")
      )
    )


    ;; ==============================================
    ;; OUTPUT
    ;; ==============================================

    (box
      :orientation "h"
      :class "row"

      (label
        :text "OUTPUT"
        :class "section"
        :halign "start")

      (label
        :text "${audio-out-muted == 'true'
          ? 'MUTED'
          : audio-out-vol + '%'}"
        :class "percent"
        :halign "end"
        :hexpand true)
    )


    ;; Barra de volumen OUTPUT

    (scale
      :min 0
      :max 100
      :value audio-out-vol
      :onchange "wpctl set-volume @DEFAULT_AUDIO_SINK@ {}%")


    ;; Lista OUTPUT

    (box
      :orientation "v"
      :spacing 4
      :space-evenly false

      (for device in audio-devices
        (audio-device-row
          :name "${device.name}"
          :id "${device.id}"
          :current "${device.current}"))
    )


    ;; ==============================================
    ;; SEPARADOR
    ;; ==============================================

    (box
      :class "audio-separator")


    ;; ==============================================
    ;; INPUT
    ;; ==============================================

    (box
      :orientation "h"
      :class "row"

      (label
        :text "INPUT"
        :class "section"
        :halign "start")

      (label
        :text "${audio-in-muted == 'true'
          ? 'MUTED'
          : audio-in-vol + '%'}"
        :class "percent"
        :halign "end"
        :hexpand true)
    )


    ;; Barra de volumen INPUT

    (scale
      :min 0
      :max 100
      :value audio-in-vol
      :onchange "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ {}%")


    ;; Lista INPUT

    (box
      :orientation "v"
      :spacing 4
      :space-evenly false

      (for device in audio-input-devices
        (audio-input-row
          :name "${device.name}"
          :id "${device.id}"
          :current "${device.current}"))
    )

  )
)


;; ==================================================
;; WINDOW
;; ==================================================

(defwindow audio-panel
  :monitor 0
  :stacking "overlay"
  :namespace "eww"

  :geometry
  (geometry
    :anchor "bottom right"
    :x "10px"
    :y "10px"
    :width "500px"
    :height "500px")

  (audio-widget)
)
