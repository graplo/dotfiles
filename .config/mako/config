history=1
max-history=20
sort=-time

font=Ubuntu 11

group-by=app-name
max-visible=5

layer=overlay
anchor=top-right

background-color=#282a36
text-color=#f8f8f2
border-color=#bd93f9
progress-color=#50fa7b

default-timeout=5000
ignore-timeout=0

width=350
height=100

padding=12
margin=0
outer-margin=10

border-size=2
border-radius=0

markup=1

format=<b>%a</b>\n%s\n%b

icons=1
max-icon-size=42
icon-path=/usr/share/icons/Papirus-Dark:/usr/share/icons/Papirus:/usr/share/icons/hicolor

[urgency=low]
border-color=#8be9fd
default-timeout=3000

[urgency=high]
background-color=#3b1f2b
border-color=#ff5555
text-color=#f8f8f2
default-timeout=0
