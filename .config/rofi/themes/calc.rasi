 Combinacion de teclas mod+shift+C               
*/


@import "~/.config/rofi/themes/colors.rasi"


/*****----- Configuration -----*****/
configuration {
    show-icons: true;
    markup-rows: true;
}


/*****----- Global -----*****/
* {
    font: "Ubuntu 12";

    background-color: @gpl-background;
    text-color: @gpl-foreground;
}


/*****----- Main Window -----*****/
window {

    transparency: "real";
    location: center;
    anchor: center;
    fullscreen: false;
    width: 650px;
    border: 3px;
    border-radius: 0px;
    border-color: @gpl-purple;
    background-color: @gpl-background;
    cursor: default;
}


/*****----- Main Layout -----*****/
mainbox {

    spacing: 0px;
    orientation: vertical;
    background-color: transparent;
    children: [
        "inputbar",
        "listbox"
    ];
}


/*****----- Search + Image -----*****/
inputbar {

    spacing: 10px;
    padding: 60px 40px;
    background-color: transparent;
    background-image: url("~/.config/rofi/images/calc/current", width);
    orientation: horizontal;
    children: [
        "textbox-prompt-colon",
        "entry",
        "dummy"
           ];
}


/*****----- Search Icon -----*****/
textbox-prompt-colon {

    expand: false;
    font: "JetBrainsMono Nerd Font 20";
    str: "";
    width: 52px;
    height: 50px;
    padding: 0px;
    border-radius: 0%;
    background-color: @gpl-purple;
    text-color: @gpl-background;
    horizontal-align: 0.5;
    vertical-align: 0.5;
}


/*****----- Search Entry -----*****/
entry {

    expand: false;
    width: 250px;
    padding: 12px 16px;
    border-radius: 0%;
    background-color: @gpl-dark;
    text-color: @gpl-foreground;
    placeholder: "Search";
    placeholder-color: @gpl-comment;
    cursor: text;
    vertical-align: 0.5;
    border: 2px;
    border-color: @gpl-purple;

}


/*****----- Spacer -----*****/
dummy {

    expand: true;
    background-color: transparent;
}


/*****----- List Area -----*****/
listbox {

    spacing: 15px;
    padding: 15px;
    background-color: transparent;
    orientation: vertical;
    children: [
        "listview"
    ];
}


listview {

    columns: 1;
    lines: 7;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    layout: vertical;
    fixed-height: true;
    fixed-columns: true;
    spacing: 10px;
    background-color: transparent;
}


/*****----- Applications -----*****/
element {

    spacing: 10px;
    padding: 8px;
    border-radius: 0px;
    background-color: transparent;
    text-color: @gpl-foreground;
    cursor: pointer;
    children: [ textbox-key-icon, element-text ];

}

textbox-key-icon {
    expand: false;
    font: "JetBrainsMono Nerd Font 14";
    content: "󱛠";
    padding: 2px 8px;
    background-color: transparent;
    text-color: inherit;
    horizontal-align: 0.5;
    vertical-align: 0.5;
}

element selected.normal {

    background-color: @gpl-purple;
    text-color: @gpl-background;
}


element-icon {

    size: 32px;
    background-color: transparent;
    text-color: inherit;
}


element-text {

    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}


/*****----- Error -----*****/
error-message {

    padding: 12px;
    border-radius: 10px;
    background-color: @gpl-red;
    text-color: @gpl-background;
}
