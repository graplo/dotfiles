/*
*/

configuration {
  wifi {
    modi: "wifi";
    state-connecting-indicator: [ "conectando .", "conectando ..", "conectando ..." ];
    state-connecting-fps: 4;
    state-scan-indicator: [ "⠻", "⠽", "⠾", "⠷", "⠯", "⠟" ];
    state-scan-fps: 10;
    icon-open: [ "󰤨", "󰤥", "󰤢", "󰤟", "󰤯" ];
    icon-psk: [ "󰤪", "󰤧", "󰤤", "󰤡", "󰤬" ];
  }
}

@import "~/.config/rofi/themes/colors.rasi"


configuration {
    show-icons: true;
    markup-rows: true;
}


* {
    font: "Ubuntu 12";
    background-color: @gpl-background;
    text-color: @gpl-foreground;
}


window {
    transparency: "real";
    location: center;
    anchor: center;
    fullscreen: false;
    width: 650px;

    border: 3px;
    border-radius: 0px;
    border-color: @gpl-purple;

    background-color: @gpl-background;
    cursor: default;
}


mainbox {
    spacing: 0px;
    orientation: vertical;

    background-color: transparent;

    children: [
        "inputbar",
        "message",
        "listbox"
    ];
}


/***** Search + Image *****/

inputbar {

spacing: 0px;
    padding: 60px 40px;

    background-color: @gpl-dark;

    background-image: url("~/.config/rofi/images/emoji.png", width);

    border: 2px;
    border-color: @gpl-purple;
    border-radius: 10px;

    children: [
        "prompt",
        "entry"
    ];
}


message {

    padding: 10px 40px;

    background-color: transparent;
    text-color: @gpl-foreground;
}


/***** Prompt (wifi animation) *****/

prompt {

enabled: true;

    padding: 12px 8px;

    background-color: @gpl-dark;

    text-color: @gpl-foreground;

    border: 2px;
    border-color: @gpl-purple;

    border-radius: 0px 0px 0px 0px;
}


/***** Search Entry *****/

entry {

expand: true;

    padding: 12px 16px;

    background-color: @gpl-dark;

    text-color: @gpl-foreground;

    placeholder: "Search";
    placeholder-color: @gpl-comment;

    cursor: text;

    vertical-align: 0.5;

    border: 2px;
    border-color: @gpl-purple;

    border-radius: 0px 0px 0px 0px;
}


/***** Spacer *****/

dummy {

    expand: true;

    background-color: transparent;
}


/***** List Area *****/

listbox {

    spacing: 15px;

    padding: 15px;

    background-color: transparent;

    orientation: vertical;

    children: [
        "listview"
    ];
}


listview {

    columns: 1;
    lines: 7;

    cycle: true;
    dynamic: true;

    scrollbar: false;

    layout: vertical;

    fixed-height: true;
    fixed-columns: true;

    spacing: 10px;

    background-color: transparent;
}


/***** Applications *****/

element {

    spacing: 10px;

    padding: 8px;

    border-radius: 0px;

    background-color: transparent;

    text-color: @gpl-foreground;

    cursor: pointer;

    children: [
        element-text
    ];
}


element selected.normal {

    background-color: @gpl-purple;

    text-color: @gpl-background;
}


element-text {

    background-color: transparent;

    padding: 6px;

    text-color: inherit;

    vertical-align: 0.5;

    font: "Ubuntu 12";
}


/***** Error *****/

error-message {

    padding: 12px;

    border-radius: 10px;

    background-color: @gpl-red;

    text-color: @gpl-background;
}
