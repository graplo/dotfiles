⢰⣿⣿⣿⣿⣿⣿⡛⠉⠁⠀⣴⡄⢠⡤⠀⣴⡄⠠⣦⠀⢰⡄⢀⣤⠀⢠⡄⠀
⠈⣿⣿⣿⣿⣿⣿⣿⣦⣀⠀⠁⠀⠈⠉⠀⠉⠁⠈⠉⠀⠈⠁⠀⠉⠀⠈⠁⠀
⠀⠈⠻⢿⣿⣿⣿⡿⠟⠁⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀
*/
configuration {
    show-icons:      true;
    font:            "JetBrainsMono Nerd Font 10";
}

* {
    /* Paleta Dracula */
    background:     #282a36;
    background-alt: #343746;
    foreground:     #f8f8f2;
    selected:       #bd93f9;
    
    background-color: transparent;
    text-color:       @foreground;
}

window {
    width:            650px; /* Lo encogemos un poco para que sea más compacto */
    height:           480px;
    border:           2px;
    border-color:     @selected;
    background-color: @background;
}

mainbox {
    orientation: vertical;
    children:    [ inputbar, listview ];
}

inputbar {
    padding:          10px;
    background-color: @background-alt;
    children:         [ entry ];
}

entry {
    placeholder:       "Buscar...";
    placeholder-color: #6272a4;
}

listview {
    padding:      6px;
    columns:      1;
    lines:        6;
    fixed-height: true;
    spacing:      4px; /* Espacio reducido entre cada fila */
}

/* ————— FILAS DE LA LISTA COMPACTADAS ————— */
element {
    padding:          6px 10px; /* Reducido drásticamente arriba/abajo */
    border-radius:    4px;
    orientation:      horizontal;
    children:         [ element-icon, element-text ];
    background-color: transparent;
}

element selected {
    background-color: @selected;
    text-color:       #1e1f29;
}

/* ————— CONTROL DE LA SEPARACIÓN INTERNA ————— */
element-icon {
    size:             48px; /* Tamaño intermedio ideal para la lista */
    margin:           0px 10px 0px 0px; /* Forzamos a que el texto empiece justo al lado del icono */
    background-color: transparent;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
    horizontal-align: 0.0; /* Forzamos a que el texto empiece inmediatamente a la izquierda */
}
