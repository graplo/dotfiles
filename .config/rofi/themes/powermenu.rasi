 /\_/\
((@v@))
():::()
 VV-VV  Graplo > Caja Power Menu
*/

@import "~/.config/rofi/themes/colors.rasi"

/*****----- Configuration -----*****/
configuration {
    show-icons:     true;
    markup-rows:    true;
    disable-history: false;
}

/*****----- Global Properties -----*****/
* {
    font: "Ubuntu 17";

    background:             @gpl-background;
    background-alt:         @gpl-dark;

    foreground:             @gpl-foreground;
    foreground-selected:    @gpl-background;

    selected:               @gpl-purple;
    active:                 @gpl-purple;
    urgent:                 @gpl-red;
}

/*****----- Main Window -----*****/
window {
    location:               center;
    anchor:                 center;

    fullscreen:             false;
    width:                  580px;
    height:                 400px;

    padding:                0px;
    border:                 3px;
    border-radius:          0px;
    border-color:           @gpl-purple;

    cursor:                 default;
    background-color:       @background;
}

/*****----- Main Box -----*****/
mainbox {
    orientation:            horizontal;
    spacing:                0px;
    background-color:       transparent;
    children:               [ "imagebox", "contentbox" ];
}

/*****----- Imagebox -----*****/
imagebox {
    expand:                 false;
    width:                  260px;

    background-color:       transparent;
    background-image:       url("~/.config/rofi/images/powermenu/current", height);
    children:               [ "dummy", "message"];
}

contentbox {
    spacing:                10px;
    background-color:       transparent;

    children:               [ "listview"];
}

listview {
    columns:                1;
    lines:                  5;

    cycle:                  true;
    dynamic:                true;
    scrollbar:              false;

    layout:                 vertical;
    fixed-height:           true;
    fixed-columns:          true;

    spacing:                8px;
    background-color:       transparent;
}

element {
    padding:                10px;
    border-radius:          0px;

    background-color:       transparent;
    text-color:             @foreground;

    cursor:                 pointer;
}

element-text {
    background-color:       transparent;
    text-color:             inherit;
    vertical-align:         0.5;
}

element-icon {
    background-color:       transparent;
    text-color:             inherit;
    size:                   42px;
}

element selected.normal {
    background-color:       @selected;
    text-color:             @foreground-selected;
}

element selected.active {
    background-color:       @selected;
    text-color:             @foreground-selected;
}

element selected.urgent {
    background-color:       @selected;
    text-color:             @foreground-selected;
}

message {
    enabled:                true;

    margin:                 10px 0px 0px 0px;
    padding:                10px;

    background-color:       @background-alt;
    text-color:             @foreground;
}

textbox {
    background-color:       transparent;
    text-color:             inherit;

    vertical-align:         0.5;
    horizontal-align:       0.5;
}

inputbar {
    enabled:                false;
}

prompt {
    enabled:                false;
}

dummy {
    background-color:       transparent;
}
