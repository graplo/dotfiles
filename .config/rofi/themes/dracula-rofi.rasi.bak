/*Dracula theme based on the Purple official rofi theme

  / _ \
\_\(_)/_/
 _//o\\_ Graplo
  /   \

*/

@import "colors.rasi"

configuration {
    show-icons:      true;
    display-drun:    "";
    disable-history: false;
}

* {
    font: "Ubuntu 12";
    background-color:           @gpl-background;
    foreground:                 @gpl-foreground;
    active-background:          @gpl-purple;
    urgent-background:          @gpl-red;
    urgent-foreground:          @gpl-background;
    selected-background:        @gpl-purple;
    selected-urgent-background: @gpl-red;
    selected-active-background: @gpl-purple;
    separatorcolor:             @gpl-purple;
    bordercolor:                @gpl-purple;
}

#window {
    background-color: @gpl-background;
    border:           2;
    border-radius:    0;
    border-color:     @gpl-purple;
    padding:          15;
    width:            720px;
}
#mainbox {
    border:  0;
    padding: 0;
}
#message {
    border:       0px;
    border-color: @gpl-purple;
    padding:      1px;
}
#textbox {
    text-color: @gpl-foreground;
}
#listview {
    fixed-height: 0;
    border:       0px;
    border-color: @gpl-purple;
    spacing:      2px ;
    scrollbar:    false;
    padding:      2px 0px 0px ;
}
#element {
    border:  0;
    padding: 3px ;
}
#element.normal.normal {
    background-color: @gpl-background;
    text-color:       @gpl-foreground;
}
#element.normal.urgent {
    background-color: @gpl-red;
    text-color:       @gpl-background;
}
#element.normal.active {
    background-color: @gpl-purple;
    text-color:       @gpl-foreground;
}
#element.selected.normal {
    background-color: @gpl-purple;
    text-color:       @gpl-background;
}
#element.selected.urgent {
    background-color: @gpl-red;
    text-color:       @gpl-foreground;
}
#element.selected.active {
    background-color: @gpl-purple;
    text-color:       @gpl-foreground;
}
#element.alternate.normal {
    background-color: @gpl-background;
    text-color:       @gpl-foreground;
}
#element.alternate.urgent {
    background-color: @gpl-red;
    text-color:       @gpl-foreground;
}
#element.alternate.active {
    background-color: @gpl-purple;
    text-color:       @gpl-foreground;
}
#scrollbar {
    width:        2px ;
    border:       0;
    handle-width: 8px ;
    padding:      0;
}
#sidebar {
    border:       2px dash 0px 0px ;
    border-color: @gpl-purple;
}
#button.selected {
    background-color: @gpl-purple;
    text-color:       @gpl-foreground;
}
#inputbar {
    spacing:    0;
    text-color: @gpl-foreground;
    padding:    1px ;
}
#case-indicator {
    spacing:    0;
    text-color: @gpl-foreground;
}
#entry {
    spacing:    0;
    text-color: @gpl-foreground;
    vertical-align: 0.5;
}
#prompt {
    spacing:    0;
    text-color: @gpl-foreground;
    vertical-align: 0.5;
}
#inputbar {
    children:   [ prompt,textbox-prompt-colon,entry,case-indicator ];
}
#textbox-prompt-colon {
    expand:     false;
    str:        "λ > ";
    margin:     0px;
    text-color: @gpl-foreground;
    vertical-align: 0.5;
}
element-text, element-icon {
    background-color: inherit;
    text-color: inherit;
}
element-text {
    vertical-align: 0.5; /* Solo afecta al texto */
}
element-icon {
    size:   32px;
}
