{
  "group/extras": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 400,
      "children-class": "extras",
      "transition-left-to-right": false
    },
    "modules": [
      "custom/menu",
      "tray"
    ]
  },
  "group/brightness": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 400,
      "children-class": "brightness",
      "transition-left-to-right": false
    },
    "modules": [
      "backlight",
      "backlight/slider"
    ]
  },
  "group/audio": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 400,
      "children-class": "audio",
      "transition-left-to-right": false
    },
    "modules": [
      "pulseaudio",
      "pulseaudio/slider"
    ]
  },
  "custom/rofi": {
    "format": "",
    "tooltip": false,
    "on-click": "rofi -show drun"
  },
  "custom/cachy": {
    "format": "",
    "tooltip": false,
    "on-click": "ghostty",
    "on-click-right": "kitty"
  },
  "niri/workspaces": {
    "on-click": "activate",
    "format": "{icon}",
    "format-icons": {
      "active": "󰮯",
      "default": "󰊠",
      "empty": "󱙝",
      "urgent": "󰊠"
    }
  },

  "custom/separator": {
    "format": "—",
    "tooltip": false
},

  "custom/weather": {
    "format": "{}",
    "interval": 1800,
    "exec": "~/.local/bin/weather.sh",
    "tooltip": false,
    "on-click": "kitty --title weathr -e weathr"
  },

  "cpu": {
    "format": "{icon}",
    "format-icons": [
      "<span size='14pt'>⠁</span>",
      "<span size='14pt'>⠉</span>",
      "<span size='14pt'>⠙</span>",
      "<span size='14pt'>⠛</span>",
      "<span size='14pt'>⠟</span>",
      "<span size='14pt'>⠿</span>"
    ],
    "interval": 1,
    "tooltip": true,
    "tooltip-format": "CPU Frequency: {avg_frequency} GHz",
    "on-click": "kitty --title btop -e btop",
    "on-click-right": "kitty --title btop -e nvtop"

  },
  "clock#hora": {
    "interval": 1,
    "format": "{:%H\n%M}",
    "tooltip": false,
    "on-click": "kitty --title peaclock -e peaclock --config-dir ~/.config/peaclock"
  },

"clock#fecha": {
    "interval": 60,
    "format": "{:%d\n%m}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "on-click": "kitty -e ikhal",
    "on-click-right": "kitty -e calcurse"
    
  },

"custom/cava-mini": {
    "exec": "~/.local/bin/cava-mini.sh",
    "return-type": "json",
    "restart-interval": 1,
    "tooltip": false,
    "rotate": 0
},
  
"mpris": {
  "format": "<span size='14pt'>{status_icon}</span>",
  "status-icons": {
    "playing": "",
    "paused": "",
    "stopped": ""
  },
  "on-click": "playerctl play-pause",
  "on-click-right": "playerctl next",
  "on-click-middle": "playerctl previous",
  "tooltip": true,
  "tooltip-format": "{title}"
},
"custom/menu": {
  "format": "<span size='16pt'>󰅃</span>",
  "tooltip": false
},
"tray": {
  "spacing": 16,
  "reverse-direction": true,
  "icon-size": 16,
  "show-passive-items": false
},
"privacy": {
  "icon-size": 14,
  "transition-duration": 250,
  "modules": [
    {
      "type": "screenshare",
      "tooltip": false
    }
  ],
  "ignore": [
    {
      "type": "screenshare",
      "name": "obs"
    }
  ]
},
"network": {
  "format-icons": {
    "wifi": [
      "<span size='12pt'>󰤯</span>",
      "<span size='12pt'>󰤟</span>",
      "<span size='12pt'>󰤢</span>",
      "<span size='12pt'>󰤥</span>",
      "<span size='12pt'>󰤨</span>"
    ],
    "ethernet": "<span size='12pt'>󰈀</span>",
    "disabled": "<span size='12pt'>󰤭</span>",
    "disconnected": "<span size='12pt'>󰤩</span>"
  },
  "format-wifi": "{icon}",
  "format-ethernet": "{icon}",
  "format-disconnected": "{icon}",
  "format-disabled": "{icon}",
  "interval": 5,
  "tooltip-format": "{essid}\t{gwaddr}",
  "on-click": "sh -c 'rfkill unblock wifi && kitty --title impala -e impala'",
  "on-click-right": "nm-connection-editor",
  "tooltip": true,
  "max-length": 20
},
"bluetooth": {
  "interval": 5,
  "format-on": "<span size='14pt'>󰂯</span>",
  "format-off": "<span size='14pt'>󰂲</span>",
  "format-disabled": "<span size='14pt'>󰂲</span>",
  "format-connected": "<span size='14pt'>󰂱</span>",
  "format-no-controller": "<span size='14pt'>󰂯</span>",
  "tooltip": true,
  "tooltip-format": "{device_enumerate}",
  "tooltip-format-enumerate-connected": "{device_address}",
  "tooltip-format-enumerate-connected-battery": "{device_address} | Battery: {device_battery_percentage}%",
  "on-click": "rfkill toggle bluetooth",
  "on-click-right": "sh -c 'rfkill unblock bluetooth && kitty --title bluetui -e bluetui'"
},
"pulseaudio#microphone": {
  "format": "{format_source}",
  "format-source": "<span size='14pt'>󰍬</span>",
  "format-source-muted": "<span size='14pt'>󰍭</span>",
  "on-click": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
  "on-click-right": "kitty -e wiremix --tab recording",
  "tooltip": false
},
"pulseaudio/slider": {
  "min": 0,
  "max": 100,
  "orientation": "vertical"
},
"pulseaudio": {
  "interval": 1,
  "format": "{icon}",
  "format-icons": [
    "<span size='14pt'>󰕿</span>",
    "<span size='14pt'>󰖀</span>",
    "<span size='14pt'>󰕾</span>"
  ],
  "format-muted": "<span size='14pt'>󰝟</span>",
  "on-click-right": "kitty -e wiremix --tab output",
  "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
  "reverse-scrolling": true,
  "tooltip": true,
  "tooltip-format": "Volume: {volume}%\n{desc}",
  "ignored-sinks": [
    "Easy Effects Sink"
  ]
},

"custom/ddc-brightness": {
    "format": "{}",
    "exec": "~/.local/bin/brightness.sh",
    "return-type": "json",
    "on-scroll-up": "ddcutil --bus 7 setvcp 10 + 5",
    "on-scroll-down": "ddcutil --bus 7 setvcp 10 - 5",
    "interval": 10,
    "tooltip": true
},

"custom/powerprofile": {
    "exec": "~/.local/bin/powerprofile-icon.sh",
    "interval": 5,
    "format": "{}",
    "on-click": "~/.local/bin/rofi-powerprofile",
    "tooltip": false
},

"backlight/slider": {
  "min": 0,
  "max": 100,
  "orientation": "vertical",
  "device": "intel_backlight"
},
"backlight": {
  "device": "intel_backlight",
  "format": "{icon}",
  "format-icons": [
    "󰃚",
    "󰃛",
    "󰃜",
    "󰃝",
    "󰃞",
    "󰃟",
    "󰃠"
  ],
  "reverse-scrolling": true,
  "smooth-scrolling-threshold": 0.2,
  "tooltip": false
},
"battery": {
  "interval": 5,
  "states": {
    "critical": 10
  },
  "format": "{icon}",
  "format-icons": [
    "<span size='14pt'>󰁺</span>",
    "<span size='14pt'>󰁻</span>",
    "<span size='14pt'>󰁼</span>",
    "<span size='14pt'>󰁽</span>",
    "<span size='14pt'>󰁾</span>",
    "<span size='14pt'>󰁿</span>",
    "<span size='14pt'>󰂀</span>",
    "<span size='14pt'>󰂁</span>",
    "<span size='14pt'>󰂂</span>",
    "<span size='14pt'>󰁹</span>"
  ],
  "format-charging": "<span size='14pt'>󰂄</span>",
  "format-plugged": "<span size='14pt'>󰚥</span>",
  "format-critical": "<span size='14pt'>󰂃</span>",
  "tooltip": true,
  "tooltip-format": "Charge: {capacity}%",
  "tooltip-format-charging": "Charging: {capacity}%"
},
"custom/powermenu": {
    "format": "<span size='13pt'>󰐥</span>",
    "on-click": "~/.local/bin/powermenu.sh",
    "tooltip": false
}
}
